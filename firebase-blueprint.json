{
  "entities": {
    "User": {
      "title": "User Profile",
      "description": "User account information and financial summary",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "displayName": { "type": "string" },
        "balance": { "type": "number" },
        "totalInvested": { "type": "number" },
        "totalProfit": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" },
        "avatarUrl": { "type": "string" },
        "bvn": { "type": "string" },
        "twoFactorEnabled": { "type": "boolean" },
        "kycVerified": { "type": "boolean" },
        "kycDetails": {
          "type": "object",
          "properties": {
            "fullName": { "type": "string" },
            "idType": { "type": "string" },
            "idNumber": { "type": "string" },
            "address": { "type": "string" }
          }
        },
        "fingerprintEnabled": { "type": "boolean" },
        "bankAccount": {
          "type": "object",
          "properties": {
            "bankName": { "type": "string" },
            "accountNumber": { "type": "string" },
            "accountName": { "type": "string" }
          }
        }
      },
      "required": ["uid", "email"]
    },
    "Investment": {
      "title": "Investment",
      "description": "An individual investment in agricultural produce",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "amount": { "type": "number" },
        "produceType": { "type": "string", "enum": ["Cattle Breeding", "Beef Processing", "Dairy Production", "Leather & Hides", "Organic Manure", "Cowhide (Kpomo)"] },
        "status": { "type": "string", "enum": ["active", "completed"] },
        "startDate": { "type": "string", "format": "date-time" },
        "endDate": { "type": "string", "format": "date-time" },
        "expectedReturn": { "type": "number" },
        "payoutAmount": { "type": "number" }
      },
      "required": ["userId", "amount", "produceType", "status", "startDate", "endDate"]
    },
    "Activity": {
      "title": "Activity",
      "description": "Financial transaction history",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "type": { "type": "string", "enum": ["investment", "payout", "deposit"] },
        "amount": { "type": "number" },
        "timestamp": { "type": "string", "format": "date-time" },
        "description": { "type": "string" }
      },
      "required": ["userId", "type", "amount", "timestamp"]
    },
    "Referral": {
      "title": "Referral Record",
      "description": "Record tracking referral relationship, KYC status, investment status, and reward state",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "referrerUid": { "type": "string" },
        "referrerCode": { "type": "string" },
        "referredUid": { "type": "string" },
        "referredName": { "type": "string" },
        "referredEmail": { "type": "string" },
        "registeredAt": { "type": "string", "format": "date-time" },
        "kycStatus": { "type": "string", "enum": ["Pending", "KYC Completed"] },
        "kycCompletedAt": { "type": "string", "format": "date-time" },
        "investmentStatus": { "type": "string", "enum": ["No Investment", "Invested"] },
        "firstInvestmentAmount": { "type": "number" },
        "firstInvestmentDate": { "type": "string", "format": "date-time" },
        "rewardAmount": { "type": "number" },
        "newInvestorBonus": { "type": "number" },
        "tierRate": { "type": "number" },
        "rewardStatus": { "type": "string", "enum": ["Pending", "Approved", "Paid", "Rejected"] },
        "fraudFlag": { "type": "boolean" },
        "fraudReason": { "type": "string" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["referrerUid", "referredUid", "rewardStatus"]
    },
    "ReferralNotification": {
      "title": "Referral Notification",
      "description": "User in-app notifications for referral lifecycle events",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "title": { "type": "string" },
        "message": { "type": "string" },
        "type": { "type": "string" },
        "read": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "title", "message"]
    },
    "ReferralSettings": {
      "title": "Referral Settings",
      "description": "Admin configuration for referral reward rates and caps",
      "type": "object",
      "properties": {
        "bronzeRate": { "type": "number" },
        "silverRate": { "type": "number" },
        "goldRate": { "type": "number" },
        "newInvestorBonusRate": { "type": "number" },
        "maxReferrerRewardCap": { "type": "number" },
        "maxNewInvestorBonusCap": { "type": "number" },
        "monthlyLimitPerUser": { "type": "number" },
        "minQualifyingInvestment": { "type": "number" },
        "updatedAt": { "type": "string", "format": "date-time" }
      }
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "User profiles"
    },
    "/investments/{investmentId}": {
      "schema": "Investment",
      "description": "Investment records"
    },
    "/activities/{activityId}": {
      "schema": "Activity",
      "description": "User activity logs"
    },
    "/referrals/{referralId}": {
      "schema": "Referral",
      "description": "Referral relationships and reward status"
    },
    "/notifications/{notificationId}": {
      "schema": "ReferralNotification",
      "description": "In-app user notifications"
    },
    "/referral_settings/{configId}": {
      "schema": "ReferralSettings",
      "description": "Global referral configuration settings"
    }
  }
}
