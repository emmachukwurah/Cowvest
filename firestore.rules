rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Phase 3: Primitives
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Pillar 2: Validation Blueprints
    function isValidUser(data) {
      return data.uid == request.auth.uid 
        && data.email is string && data.email.size() <= 128
        && data.displayName is string && data.displayName.size() <= 128
        && data.balance is number && data.balance >= 0
        && data.totalInvested is number && data.totalInvested >= 0
        && data.totalProfit is number && data.totalProfit >= 0;
    }

    function isValidInvestment(data) {
      return data.userId == request.auth.uid
        && data.amount is number && data.amount >= 100000 && data.amount <= 10000000
        && data.produceType in ['Cattle Breeding', 'Beef Processing', 'Dairy Production', 'Leather & Hides', 'Organic Manure', 'Cowhide (Kpomo)']
        && data.status in ['active', 'completed']
        && data.startDate is string
        && data.endDate is string
        && data.expectedReturn == data.amount * 0.2
        && data.payoutAmount == data.amount * 1.2;
    }

    // 1. Users Collection
    match /users/{userId} {
      allow read, write: if true;
    }

    // 2. Investments Collection
    match /investments/{investmentId} {
      allow read, write: if true;
    }

    // 3. Activities Collection
    match /activities/{activityId} {
      allow read, write: if true;
    }

    // 4. Referrals Collection
    match /referrals/{referralId} {
      allow read, write: if true;
    }

    // 5. Notifications Collection
    match /notifications/{notificationId} {
      allow read, write: if true;
    }

    // 6. Referral Settings Collection
    match /referral_settings/{configId} {
      allow read, write: if true;
    }
  }
}
